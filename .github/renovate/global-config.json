{
  "repositories": [
    "evan-cz/cloudzero-agent"
  ],
  "allowedPostUpgradeCommands": ["^make "],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "postUpgradeTasks": {
        "commands": ["make install-tools generate format"],
        "fileFilters": ["tests/helm/template/*.yaml"]
      }
    }
  ]
}
